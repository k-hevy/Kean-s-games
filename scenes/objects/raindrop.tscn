[gd_scene format=3 uid="uid://dn4war6ncffae"]

[ext_resource type="Texture2D" uid="uid://5dkstnay3vu" path="res://graphics/raindrop.png" id="1_rh3xa"]

[sub_resource type="GDScript" id="GDScript_vlwrh"]
script/source = "extends Area2D

const BASE_VALUE: int = 1
var fall_speed: int = 400
var value: float


func _ready() -> void:
	Global.upgrade_purchased.connect(_on_purchase_upgrade)
	value = BASE_VALUE * Global.get_effect(\"raindrop_value\")


func _physics_process(_delta: float) -> void:
	position.y += fall_speed * _delta


func _on_body_entered(_body: Node2D) -> void:
	queue_free()
	

## Updates raindrop Stats through a match
func _on_purchase_upgrade(upgrade_name: String, new_value: float) -> void:
	match upgrade_name:
		\"raindrop_value\":
			value = new_value
"

