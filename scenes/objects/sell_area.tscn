[sub_resource type="GDScript" id="GDScript_caxx5"]
script/source = "extends Node2D

@onready var timer: Timer = $Timer


#Add a check here to check for ONLY the player entering
func _on_area_2d_body_entered(_player: Node2D) -> void:
	timer.start()

func _on_area_2d_body_exited(_player: Node2D) -> void:
	timer.stop()
	drain()

func _on_timer_timeout() -> void:
	drain()
	
func drain() -> void:
	if Global.water > 0 and Input.is_action_pressed(\"drain\"):
		var empty_speed = Global.get_effect(Enums.UpgradeType.EMPTY_SPEED)
		if Global.water > empty_speed:
			Global.water -= empty_speed
			Global.tokens += empty_speed
		else:
			Global.tokens += Global.water 
			Global.water = 0
"

