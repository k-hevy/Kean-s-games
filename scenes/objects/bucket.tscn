[sub_resource type="GDScript" id="GDScript_4mj0c"]
script/source = "extends Area2D

@export var bucket_offset: float = 20.0
@export var min_radius: float = 30.0
@export var smooth_speed: float = 15.0
@export var max_radius: float = 800.0
@onready var sprite: Sprite2D = %Sprite2D
var pop_tween: Tween

signal spawn_text(text: String, pos: Vector2)

func _process(_delta: float) -> void:
	
	# Gets the mouse positon relaitve to the Player not the Bucket
	# displacement of mouse to player
	var mouse_from_player = get_parent().get_local_mouse_position()
	var mouse_distance = mouse_from_player.length()
	var target_position: Vector2
	
	# Checks the bounderes else 
	# sets a target destination first then interpolates
	if mouse_distance > min_radius and mouse_distance < max_radius:
		var dir = mouse_from_player.normalized()
		target_position = dir * bucket_offset
	else:
		target_position = Vector2(0,bucket_offset)
		
	position =  position.lerp(target_position, smooth_speed * _delta)


func _on_area_entered(raindrop: Area2D) -> void:
	# checks if the body is a raindrop
	if raindrop.is_in_group(\"raindrops\"):
		if Global.water < Global.get_effect(\"bucket_capacity\"):
			Global.water += raindrop.value
			if Global.water > Global.get_effect(\"bucket_capacity\"):
				Global.water = Global.get_effect(\"bucket_capacity\") # Sets it so it does go over the max
			raindrop.queue_free()
			pop_animation(str(raindrop.value))
		else:
			raindrop.queue_free()
			pop_animation(\"full\")


func pop_animation(points: String) -> void:
	
	# Kills animation tween early
	if pop_tween and pop_tween.is_running():
		pop_tween.kill()
	
	# Returns to original scale
	sprite.scale = Vector2(1.3, 0.7)
		
	# Creates the tween and spawns text
	pop_tween = create_tween().set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	pop_tween.tween_property(sprite, \"scale\", Vector2(1.0, 1.0), 0.25)
	
	spawn_text.emit(points, global_position)
"

