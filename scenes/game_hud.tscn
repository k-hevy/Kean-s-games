[gd_scene format=3 uid="uid://b2eb05rqitm07"]

[ext_resource type="PackedScene" uid="uid://cv4r1t76hlkss" path="res://scenes/shop.tscn" id="1_jna2d"]

[sub_resource type="GDScript" id="GDScript_n64bn"]
script/source = "extends CanvasLayer

@onready var water_score = $Hud_Manager/Water_Score
@onready var token_score = $Hud_Manager/Token_Score

@onready var shop_ui:= $Hud_Manager/Shop
@onready var shop_area:= $\"../objects/shop_area\"

func _ready() -> void:
	
	shop_area.shop_close.connect(on_close_shop)
	shop_area.shop_open.connect(on_open_shop)
	
	shop_ui.visible = false
	
func _process(_delta: float) -> void:
	set_labels()
	

func on_close_shop():
	shop_ui.visible = false
	
	
func on_open_shop():
	shop_ui.visible = true
	
func set_labels() -> void:
	water_score.text = \"Water: \" + str(Global.water)
	token_score.text = \"Tokens: \" + str(Global.tokens)
"

