[sub_resource type="GDScript" id="GDScript_n64bn"]
script/source = "extends CanvasLayer

@onready var water_score = $Hud_Manager/Water_Score
@onready var token_score = $Hud_Manager/Token_Score

@onready var shop_ui:= $Hud_Manager/Shop
@onready var shop_area:= %Shop_Area


func _ready() -> void:
	
	EventBus.shop_close.connect(on_close_shop)
	EventBus.shop_open.connect(on_open_shop)
	
	shop_ui.visible = false
	
func _process(_delta: float) -> void:
	set_labels()


func on_close_shop():
	shop_ui.visible = false


func on_open_shop():
	shop_ui.visible = true


func set_labels() -> void:
	water_score.text = \"Water: \" + str(Global.water)
	token_score.text = \"Tokens: \" + str(Global.tokens)


func _on_save_button_pressed() -> void:
	Global.save_game()
"

[sub_resource type="GDScript" id="GDScript_jna2d"]

[sub_resource type="GDScript" id="GDScript_g4v7s"]
script/source = "extends Node2D

func _ready() -> void:
	EventBus.spawn_text.connect(_spawn_pop_text)

func _spawn_pop_text(txt: String, world_pos: Vector2) -> void:
	
	var screen_pos: Vector2
	var camera = get_viewport().get_camera_2d() #Gets the Camera being used
	if camera:
		# Translate world coordiantes --> Canvas Layer cordinates
		screen_pos = camera.get_canvas_transform() * world_pos
	else:
		screen_pos = world_pos 
		
	#Initialization
	var label = Label.new()
	label.text = txt
	label.global_position = screen_pos +  Vector2(-10, -20)
	if label.text == \"full\":
		label.modulate = Color(0.733, 0.051, 0.0, 1.0)
	else: 
		label.modulate = Color(0.0, 0.428, 0.803, 1.0)
	self.get_parent().add_child(label)
	
	# Tells the twin to run all aniamtions simultaneously
	var text_tween = create_tween().set_parallel(true)
	
	# obj, property, final position, duration (Godot 4 require syou to type whole packages)
	var target_position = Vector2(label.global_position.x, label.global_position.y - 30.0)
	text_tween.tween_property(label, \"global_position\", target_position, 0.6)
	var target_color = Color(label.modulate.r, label.modulate.g, label.modulate.b, 0)
	text_tween.tween_property(label, \"modulate\", target_color, 0.6)
	
	# Pauses parallel behavior and deletes the text
	text_tween.chain().tween_callback(label.queue_free)
"

